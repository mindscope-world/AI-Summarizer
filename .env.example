# Copy to `.env` for local development. `.env*` files are git-ignored.
# All variables below are read by the Express server ONLY (server/lib/env.ts).
# None are exposed to the browser bundle: never prefix a secret with VITE_.

# --- Required ---------------------------------------------------------------
# GROQ_API_KEY: Groq API key. Groq hosts open-weights models; LangChain talks to it.
# Create one (free tier available) at https://console.groq.com/keys
# The server refuses to start if this is missing or still the placeholder.
GROQ_API_KEY="MY_GROQ_API_KEY"

# --- Optional (defaults shown) ----------------------------------------------
# PORT: port the API server listens on. Vite proxies /api to this in dev.
PORT=3001

# NODE_ENV: development | production | test
NODE_ENV=development

# APP_URL: public URL where the app is hosted (used for links / OAuth later).
APP_URL="http://localhost:3000"

# MAX_UPLOAD_MB: maximum size of an uploaded document.
MAX_UPLOAD_MB=50

# JSON_BODY_LIMIT: maximum JSON request body (e.g. pasted text).
JSON_BODY_LIMIT=2mb

# RATE_LIMIT_PER_MINUTE: requests per user (or per IP when signed out) per minute.
RATE_LIMIT_PER_MINUTE=60

# EXTRACT_RATE_LIMIT_PER_MINUTE: stricter limit for POST /api/extract (CPU/network heavy).
EXTRACT_RATE_LIMIT_PER_MINUTE=20

# MAX_PDF_PAGES / MAX_EXTRACTED_CHARS: refuse documents larger than this.
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=3000000

# URL_FETCH_TIMEOUT_MS / URL_FETCH_MAX_MB: limits when fetching a web article by URL.
URL_FETCH_TIMEOUT_MS=15000
URL_FETCH_MAX_MB=10

# LLM_MODEL: open-weights chat model used for summarization (LangChain + Groq). Use a gpt-oss model:
# Groq's free tier caps Qwen at 1000 output tokens/minute, which is too small for summarization.
LLM_MODEL=openai/gpt-oss-120b

# OCR_MODEL: vision-capable open-weights model that reads scanned PDFs (no text layer).
OCR_MODEL=qwen/qwen3.8-27b

# OCR_MAX_PAGES: refuse scanned PDFs with more pages than this (each page is one API call).
OCR_MAX_PAGES=20

# LLM_TIMEOUT_MS / LLM_MAX_RETRIES: per-request timeout and automatic retries on 429/5xx.
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3

# GROQ_BASE_URL: optional. Point LangChain at a proxy or another compatible server.
# GROQ_BASE_URL=

# CORS_ORIGINS: comma-separated browser origins allowed to call the API
# cross-origin. Leave empty for same-origin only (the default, via Vite proxy
# in dev and Express static hosting in production).
CORS_ORIGINS=

# TRUST_PROXY: number of reverse-proxy hops in front of the server (Cloud Run = 1)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
