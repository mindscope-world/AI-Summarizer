# Copy to `.env` for local development. `.env*` files are git-ignored.
# All variables below are read by the Express server ONLY (server/lib/env.ts).
# None are exposed to the browser bundle: never prefix a secret with VITE_.

# --- Required ---------------------------------------------------------------
# GEMINI_API_KEY: Gemini API key used for summarization. The server refuses to
# start if this is missing or still the placeholder value.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Optional (defaults shown) ----------------------------------------------
# PORT: port the API server listens on. Vite proxies /api to this in dev.
PORT=3001

# NODE_ENV: development | production | test
NODE_ENV=development

# APP_URL: public URL where the app is hosted (used for links / OAuth later).
APP_URL="http://localhost:3000"

# MAX_UPLOAD_MB: maximum size of an uploaded document.
MAX_UPLOAD_MB=50

# JSON_BODY_LIMIT: maximum JSON request body (e.g. pasted text).
JSON_BODY_LIMIT=2mb

# RATE_LIMIT_PER_MINUTE: requests per user (or per IP when signed out) per minute.
RATE_LIMIT_PER_MINUTE=60

# CORS_ORIGINS: comma-separated browser origins allowed to call the API
# cross-origin. Leave empty for same-origin only (the default, via Vite proxy
# in dev and Express static hosting in production).
CORS_ORIGINS=

# TRUST_PROXY: number of reverse-proxy hops in front of the server (Cloud Run = 1)
# so rate limiting sees the real client IP.
TRUST_PROXY=0

# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info
